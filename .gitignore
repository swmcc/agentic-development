# Machine-local herdr overrides belong in ~/.config/herdr, but ignore them here
# too so a stray copy in the repo can never be committed.
*.local.yaml
*.local.toml

__pycache__/
*.pyc
.e2e-tmp/
.pytest-tmp/
.pytest_cache/
plan.md

# C2 collects live state into here; none of it belongs in git.
c2/state/
