#!/usr/bin/env python3
"""thrawn — plan deeply, execute in parallel.

Give it a ticket (GitHub/GitLab) or a markdown brief. It deep-thinks a plan
with a strong model, splits the work into tasks, spawns one agent per task
in an isolated git worktree (visible as herdr panes), merges the results,
runs your checks, and gates the push behind a one-time code.

Stdlib only. Python >= 3.11 (tomllib).
"""

import argparse
import hashlib
import json
import os
import re
import secrets
import shlex
import shutil
import subprocess
import sys
import time
import tomllib
from datetime import datetime, timezone
from pathlib import Path

# ---------------------------------------------------------------------------
# Terminal colours
# ---------------------------------------------------------------------------

def _c(code: str) -> str:
    return code if sys.stdout.isatty() else ""

GREEN = _c("\x1b[32m")
YELLOW = _c("\x1b[33m")
RED = _c("\x1b[31m")
BLUE = _c("\x1b[34m")
DIM = _c("\x1b[2m")
BOLD = _c("\x1b[1m")
RESET = _c("\x1b[0m")

STATUS_ICON = {
    "pending": f"{DIM}○{RESET}",
    "running": f"{YELLOW}◐{RESET}",
    "done": f"{GREEN}●{RESET}",
    "failed": f"{RED}✖{RESET}",
}


def info(msg: str) -> None:
    print(f"{BLUE}thrawn{RESET} {msg}")


def live(msg: str) -> None:
    """In-place single-line progress update (tty only)."""
    if sys.stdout.isatty():
        print(f"\r\x1b[2K  {msg}", end="", flush=True)


def live_done() -> None:
    if sys.stdout.isatty():
        print("\r\x1b[2K", end="", flush=True)


def confirm(question: str) -> bool:
    """Explicit human consent. Non-interactive contexts always answer no —
    thrawn never assumes a yes."""
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        return False
    try:
        ans = input(f"{BLUE}thrawn{RESET} {question} [y/N] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return ans in ("y", "yes")


def die(msg: str, code: int = 1) -> None:
    print(f"{RED}thrawn: {msg}{RESET}", file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------------------
# Subprocess helpers
# ---------------------------------------------------------------------------

def run(argv, cwd=None, check=True, input_text=None, timeout=None):
    """Run a command, capture output. Returns CompletedProcess."""
    try:
        return subprocess.run(
            argv,
            cwd=cwd,
            check=check,
            input=input_text,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except subprocess.CalledProcessError as exc:
        if check:
            die(
                f"command failed: {' '.join(map(str, argv))}\n"
                f"{(exc.stderr or exc.stdout or '').strip()[-2000:]}"
            )
        raise


def try_run(argv, cwd=None, timeout=None):
    """Run without raising; returns CompletedProcess or None on OSError."""
    try:
        return subprocess.run(
            argv, cwd=cwd, capture_output=True, text=True, timeout=timeout
        )
    except (OSError, subprocess.TimeoutExpired):
        return None


def have(cmd: str) -> bool:
    return shutil.which(cmd) is not None


# ---------------------------------------------------------------------------
# Paths & config
# ---------------------------------------------------------------------------

def install_root() -> Path:
    """Directory containing runners.toml/prompts/, resolved through symlinks."""
    return Path(__file__).resolve().parent.parent


def repo_root() -> Path:
    proc = try_run(["git", "rev-parse", "--show-toplevel"])
    if not proc or proc.returncode != 0:
        die("not inside a git repository")
    return Path(proc.stdout.strip())


def state_dir(repo: Path) -> Path:
    return repo / ".thrawn"


def worktree_base(repo: Path) -> Path:
    """Worktrees live OUTSIDE the repo, in a non-hidden path.

    NO path component may start with a dot — tools that special-case hidden
    paths break inside them. rubocop, for one, disables ALL Include/Exclude
    filtering when the base dir is under a hidden directory (this rules out
    both <repo>/.thrawn and ~/.cache), so checks pass at the repo root but
    fail in the worktree on files like bin/* and db/schema.rb."""
    tag = hashlib.sha1(str(repo).encode()).hexdigest()[:8]
    if sys.platform == "darwin":
        base = Path.home() / "Library" / "Caches" / "thrawn"
    else:
        base = Path(f"/var/tmp/thrawn-{os.environ.get('USER', 'thrawn')}")
    return base / "worktrees" / f"{repo.name}-{tag}"


def ensure_git_exclude(repo: Path) -> None:
    """Keep .thrawn/ out of git without touching tracked .gitignore."""
    exclude = repo / ".git" / "info" / "exclude"
    try:
        existing = exclude.read_text() if exclude.exists() else ""
        if ".thrawn/" not in existing:
            exclude.parent.mkdir(parents=True, exist_ok=True)
            with exclude.open("a") as fh:
                if existing and not existing.endswith("\n"):
                    fh.write("\n")
                fh.write(".thrawn/\n")
    except OSError:
        pass


def _merge(base: dict, over: dict) -> dict:
    out = dict(base)
    for key, val in over.items():
        if isinstance(val, dict) and isinstance(out.get(key), dict):
            out[key] = _merge(out[key], val)
        else:
            out[key] = val
    return out


def load_config(repo: Path) -> dict:
    """defaults <- install runners.toml <- ~/.config/thrawn/runners.toml <- repo/.thrawn.toml"""
    cfg: dict = {
        "thrawn": {
            "planner": "fable-plan",
            "integrator": "opus",
            "default_runner": "opus",
            "allowed_runners": ["opus", "haiku", "codex", "local", "pi"],
            "max_tasks": 6,
            "integrator_attempts": 2,
            "poll_seconds": 2,
            "recon_runner": "",  # empty = use the planner runner
            "recon_max_age_commits": 50,
            "auto_recon": True,  # dispatch runs recon first when no cache exists
            "auto_fix": False,   # dispatch integrator agents WITHOUT asking? no.
            "allow_no_checks": False,  # green with zero checks? never silently.
        },
        "checks": {"commands": []},
        "worktree": {"setup": ""},
        "runners": {},
    }
    paths = [
        install_root() / "runners.toml",
        Path.home() / ".config" / "thrawn" / "runners.toml",
        repo / ".thrawn.toml",
    ]
    for path in paths:
        if path.exists():
            try:
                cfg = _merge(cfg, tomllib.loads(path.read_text()))
            except tomllib.TOMLDecodeError as exc:
                die(f"bad TOML in {path}: {exc}")
    return cfg


def runner_argv(cfg: dict, name: str, prompt: str):
    runner = cfg["runners"].get(name)
    if not runner or "argv" not in runner:
        return None
    return [prompt if a == "{prompt}" else a for a in runner["argv"]]


def load_prompt(name: str) -> str:
    path = install_root() / "prompts" / name
    if not path.exists():
        die(f"missing prompt file: {path}")
    return path.read_text()


def render(template: str, **kw: str) -> str:
    for key, val in kw.items():
        template = template.replace("{{" + key + "}}", val)
    return template


# ---------------------------------------------------------------------------
# Run state
# ---------------------------------------------------------------------------

def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def fmt_dur(seconds: float) -> str:
    seconds = max(0, int(seconds))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m{seconds % 60:02d}s"
    return f"{seconds // 3600}h{(seconds % 3600) // 60:02d}m"


def since(iso: str) -> str:
    try:
        start = datetime.strptime(iso, "%Y-%m-%dT%H:%M:%SZ").replace(
            tzinfo=timezone.utc
        )
    except (TypeError, ValueError):
        return "?"
    return fmt_dur((datetime.now(timezone.utc) - start).total_seconds())


# ---------------------------------------------------------------------------
# Activity — "what is the agent doing right now" from log tails
# ---------------------------------------------------------------------------

def _last_lines(path: Path, nbytes: int = 16384):
    try:
        with path.open("rb") as fh:
            fh.seek(max(0, path.stat().st_size - nbytes))
            return fh.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return []


def _describe_event(evt: dict):
    """One readable line from a claude --output-format stream-json event."""
    etype = evt.get("type")
    if etype == "assistant":
        for block in reversed((evt.get("message") or {}).get("content", [])):
            btype = block.get("type")
            if btype == "tool_use":
                arg = block.get("input") or {}
                hint = (arg.get("description") or arg.get("command")
                        or arg.get("file_path") or arg.get("pattern") or "")
                name = block.get("name", "tool")
                return f"{name}: {hint}" if hint else name
            if btype == "text" and block.get("text", "").strip():
                return block["text"].strip().splitlines()[0]
    if etype == "system" and evt.get("subtype") == "init":
        return "session started"
    if etype == "result":
        return "wrapping up"
    return None


def describe_activity(log: Path, width: int = 60) -> str:
    """Last meaningful line of a log — JSONL-aware, raw-text fallback."""
    for line in reversed(_last_lines(log)):
        line = line.strip()
        if not line:
            continue
        if line.startswith("{"):
            try:
                evt = json.loads(line)
            except json.JSONDecodeError:
                return line[:width]
            desc = _describe_event(evt)
            if desc:
                return desc[:width]
            continue  # uninteresting event — keep looking back
        return line[:width]
    return ""


def stream_cmd(argv, cwd, log: Path, label: str, timeout: int = 1800,
               echo: bool = False) -> bool:
    """Run a command, output to `log`.

    echo=True: the command's full output ALSO streams to this terminal,
    line by line, like running it yourself — nothing hidden, nothing erased.
    echo=False: quiet, with a live elapsed/activity ticker instead."""
    start = time.monotonic()
    last_note = 0.0
    with log.open("wb") as fh:
        proc = subprocess.Popen(
            argv, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT
        )
        if echo:
            for chunk in iter(proc.stdout.readline, b""):
                fh.write(chunk)
                fh.flush()
                sys.stdout.buffer.write(chunk)
                sys.stdout.flush()
                if time.monotonic() - start > timeout:
                    proc.kill()
                    info(f"{RED}timed out after "
                         f"{fmt_dur(time.monotonic() - start)}: {label}{RESET}")
                    return False
            proc.wait()
        else:
            while True:
                try:
                    proc.wait(timeout=2)
                    break
                except subprocess.TimeoutExpired:
                    pass
                elapsed = time.monotonic() - start
                if elapsed > timeout:
                    proc.kill()
                    live_done()
                    info(f"{RED}timed out after {fmt_dur(elapsed)}: {label}{RESET}")
                    return False
                act = describe_activity(log, 50)
                if sys.stdout.isatty():
                    live(f"{YELLOW}◐{RESET} {label} {YELLOW}{fmt_dur(elapsed)}{RESET}"
                         + (f" {DIM}{act}{RESET}" if act else ""))
                elif elapsed - last_note >= 30:
                    info(f"… {label} {fmt_dur(elapsed)}" + (f" — {act}" if act else ""))
                    last_note = elapsed
            live_done()
            # drain anything the pipe still holds into the log
            rest = proc.stdout.read()
            if rest:
                fh.write(rest)
    return proc.returncode == 0


def run_dir(repo: Path, run_id: str) -> Path:
    return state_dir(repo) / "runs" / run_id


def load_state(repo: Path, run_id: str) -> dict:
    path = run_dir(repo, run_id) / "state.json"
    if not path.exists():
        die(f"no such run: {run_id} (see `thrawn runs`)")
    return json.loads(path.read_text())


def save_state(repo: Path, state: dict) -> None:
    path = run_dir(repo, state["run_id"]) / "state.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(state, indent=2))


def list_runs(repo: Path):
    base = state_dir(repo) / "runs"
    if not base.exists():
        return []
    runs = []
    for entry in sorted(base.iterdir()):
        sf = entry / "state.json"
        if sf.exists():
            try:
                runs.append(json.loads(sf.read_text()))
            except json.JSONDecodeError:
                continue
    return runs


def latest_run(repo: Path):
    runs = list_runs(repo)
    if not runs:
        die("no runs yet — start one with `thrawn <issue#|brief.md>`")
    return sorted(runs, key=lambda s: s.get("created", ""))[-1]


def unique_run_id(repo: Path, base_id: str) -> str:
    rid, n = base_id, 2
    while run_dir(repo, rid).exists():
        rid = f"{base_id}-{n}"
        n += 1
    return rid


# ---------------------------------------------------------------------------
# Intake — gh / glab / markdown brief
# ---------------------------------------------------------------------------

def detect_host(repo: Path):
    proc = try_run(["git", "remote", "get-url", "origin"], cwd=repo)
    url = proc.stdout.strip() if proc and proc.returncode == 0 else ""
    if "github" in url:
        return "github", url
    if "gitlab" in url:
        return "gitlab", url
    return None, url


def fetch_issue(repo: Path, number: str):
    host, _ = detect_host(repo)
    if host == "github":
        if not have("gh"):
            die("gh CLI not installed")
        proc = run(
            ["gh", "issue", "view", number, "--json", "number,title,body,labels"],
            cwd=repo,
        )
        data = json.loads(proc.stdout)
        labels = ", ".join(lab["name"] for lab in data.get("labels", []))
        body = data.get("body") or "(no description)"
        text = f"# {data['title']}\n\nLabels: {labels or 'none'}\n\n{body}"
        return {"kind": "github", "ref": number, "title": data["title"], "text": text}
    if host == "gitlab":
        if not have("glab"):
            die("glab CLI not installed")
        proc = try_run(["glab", "issue", "view", number, "--output", "json"], cwd=repo)
        if proc and proc.returncode == 0:
            try:
                data = json.loads(proc.stdout)
                title = data.get("title", f"issue {number}")
                body = data.get("description") or "(no description)"
                return {
                    "kind": "gitlab",
                    "ref": number,
                    "title": title,
                    "text": f"# {title}\n\n{body}",
                }
            except json.JSONDecodeError:
                pass
        proc = run(["glab", "issue", "view", number], cwd=repo)
        first = proc.stdout.strip().splitlines()[0] if proc.stdout.strip() else ""
        return {
            "kind": "gitlab",
            "ref": number,
            "title": first or f"issue {number}",
            "text": proc.stdout,
        }
    die("origin remote is neither GitHub nor GitLab — use a markdown brief instead")


def read_brief(path: Path):
    text = path.read_text()
    title = next(
        (ln.lstrip("# ").strip() for ln in text.splitlines() if ln.startswith("#")),
        path.stem,
    )
    return {"kind": "brief", "ref": str(path), "title": title, "text": text}


def resolve_target(repo: Path, target):
    if target is None:
        default = repo / "THRAWN.md"
        if default.exists():
            return read_brief(default)
        die("no target: pass an issue number, a brief.md path, or add THRAWN.md")
    if re.fullmatch(r"#?\d+", target):
        return fetch_issue(repo, target.lstrip("#"))
    path = Path(target)
    if path.exists() and path.suffix == ".md":
        return read_brief(path)
    die(f"target not understood: {target} (issue number or .md file)")


def make_run_id(repo: Path, intake: dict) -> str:
    if intake["kind"] == "github":
        base = f"gh-{intake['ref']}"
    elif intake["kind"] == "gitlab":
        base = f"gl-{intake['ref']}"
    else:
        slug = re.sub(r"[^a-z0-9]+", "-", intake["title"].lower()).strip("-")[:24]
        base = slug or "brief"
    return unique_run_id(repo, base)


# ---------------------------------------------------------------------------
# Recon — cached per-repo codebase brief
# ---------------------------------------------------------------------------

def recon_paths(repo: Path):
    return state_dir(repo) / "recon.md", state_dir(repo) / "recon.json"


def recon_age_commits(repo: Path, meta: dict):
    """Commits on HEAD since the recon was taken; None if unknowable."""
    commit = meta.get("commit")
    if not commit:
        return None
    proc = try_run(["git", "rev-list", "--count", f"{commit}..HEAD"], cwd=repo)
    if proc and proc.returncode == 0:
        try:
            return int(proc.stdout.strip())
        except ValueError:
            return None
    return None  # commit unknown to this history (rebase/gc) — treat as stale


def load_recon(repo: Path, cfg: dict) -> str:
    """Return the recon brief for prompt injection, or a no-cache marker."""
    md_path, meta_path = recon_paths(repo)
    if not md_path.exists():
        return "(no cached brief — explore the repo yourself)"
    try:
        meta = json.loads(meta_path.read_text()) if meta_path.exists() else {}
    except json.JSONDecodeError:
        meta = {}
    age = recon_age_commits(repo, meta)
    max_age = cfg["thrawn"]["recon_max_age_commits"]
    if age is None or age > max_age:
        info(f"{YELLOW}recon cache is stale "
             f"({'unknown age' if age is None else f'{age} commits old'}) — "
             f"refresh with `thrawn recon`{RESET}")
        staleness = (
            "NOTE: this brief is STALE — verify anything load-bearing "
            "against the actual code."
        )
    else:
        staleness = (
            f"This brief is {age} commit(s) old — trust it for orientation, "
            "verify specifics you depend on."
        )
    return f"{staleness}\n\n{md_path.read_text()}"


def cmd_recon(repo: Path, cfg: dict) -> None:
    ensure_git_exclude(repo)
    tc = cfg["thrawn"]
    runner = tc["recon_runner"] or tc["planner"]
    argv = runner_argv(cfg, runner, load_prompt("recon.md"))
    if argv is None:
        die(f"recon runner `{runner}` not defined in runners.toml")
    info(f"surveying the terrain with {BOLD}{runner}{RESET} …")
    proc = try_run(argv, cwd=repo, timeout=1800)
    if proc is None or proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()[-2000:] if proc else "not found"
        die(f"recon failed:\n{detail}")
    md_path, meta_path = recon_paths(repo)
    md_path.parent.mkdir(parents=True, exist_ok=True)
    md_path.write_text(proc.stdout.strip() + "\n")
    commit = run(["git", "rev-parse", "HEAD"], cwd=repo).stdout.strip()
    meta_path.write_text(json.dumps(
        {"commit": commit, "created": now_iso(), "runner": runner}, indent=2
    ))
    lines = len(proc.stdout.strip().splitlines())
    info(f"{GREEN}recon saved{RESET} → .thrawn/recon.md "
         f"({lines} lines, pinned to {commit[:8]})")


# ---------------------------------------------------------------------------
# Planning — deep think with the planner model
# ---------------------------------------------------------------------------

def extract_json(text: str) -> dict:
    fence = re.search(r"```(?:json)?\s*(\{.*?\})\s*```", text, re.S)
    candidates = [fence.group(1)] if fence else []
    start, end = text.find("{"), text.rfind("}")
    if start != -1 and end > start:
        candidates.append(text[start : end + 1])
    for cand in candidates:
        try:
            return json.loads(cand)
        except json.JSONDecodeError:
            continue
    raise ValueError("no JSON object found in planner output")


def validate_plan(cfg: dict, plan: dict, run_id: str) -> dict:
    tc = cfg["thrawn"]
    allowed = set(tc["allowed_runners"]) & set(cfg["runners"])
    tasks = plan.get("tasks") or []
    if not tasks:
        die("planner produced no tasks")
    if len(tasks) > tc["max_tasks"]:
        tasks = tasks[: tc["max_tasks"]]
    seen = set()
    for i, task in enumerate(tasks):
        task.setdefault("id", f"t{i + 1}")
        if task["id"] in seen:
            die(f"plan has duplicate task id: {task['id']}")
        seen.add(task["id"])
        task.setdefault("title", task["id"])
        task.setdefault("deps", [])
        task.setdefault("complexity", "medium")
        if task.get("runner") not in allowed:
            replacement = (
                "haiku"
                if task["complexity"] == "low" and "haiku" in allowed
                else tc["default_runner"]
            )
            info(f"{YELLOW}plan wanted runner `{task.get('runner')}` for "
                 f"{task['id']} — not allowed/defined, using `{replacement}`{RESET}")
            task["runner"] = replacement
        if "prompt" not in task or not task["prompt"].strip():
            die(f"plan task {task['id']} has no prompt")
    ids = {t["id"] for t in tasks}
    for task in tasks:
        bad = [d for d in task["deps"] if d not in ids]
        if bad:
            die(f"task {task['id']} depends on unknown task(s): {bad}")
    plan["tasks"] = tasks
    plan.setdefault("summary", run_id)
    branch = plan.get("branch") or f"thrawn/{run_id}"
    plan["branch"] = re.sub(r"[^A-Za-z0-9/_.-]+", "-", branch)
    plan.setdefault("pr", {})
    plan["pr"].setdefault("title", plan["summary"][:70])
    plan["pr"].setdefault("body", plan["summary"])
    return plan


def run_planner(repo: Path, cfg: dict, intake: dict, run_id: str) -> dict:
    tc = cfg["thrawn"]
    allowed = [r for r in tc["allowed_runners"] if r in cfg["runners"]]
    runner_notes = "\n".join(
        f"- `{name}`: {cfg['runners'][name].get('notes', 'no notes')}"
        for name in allowed
    )
    prompt = render(
        load_prompt("planner.md"),
        run_id=run_id,
        ticket=intake["text"],
        runners=runner_notes,
        max_tasks=str(tc["max_tasks"]),
        recon=load_recon(repo, cfg),
    )
    argv = runner_argv(cfg, tc["planner"], prompt)
    if argv is None:
        die(f"planner runner `{tc['planner']}` not defined in runners.toml")
    info(f"deep thinking with {BOLD}{tc['planner']}{RESET} … (this is the slow part)")
    proc = try_run(argv, cwd=repo, timeout=1800)
    if proc is None or proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()[-2000:] if proc else "not found"
        die(f"planner failed:\n{detail}")
    raw_path = run_dir(repo, run_id) / "planner-raw.txt"
    raw_path.parent.mkdir(parents=True, exist_ok=True)
    raw_path.write_text(proc.stdout)
    try:
        plan = extract_json(proc.stdout)
    except ValueError:
        die(f"planner output was not valid JSON — raw output saved to {raw_path}")
    plan = validate_plan(cfg, plan, run_id)
    (run_dir(repo, run_id) / "plan.json").write_text(json.dumps(plan, indent=2))
    return plan


# ---------------------------------------------------------------------------
# Spawning — herdr panes when available, plain subprocesses otherwise
# ---------------------------------------------------------------------------

def herdr_available() -> bool:
    if os.environ.get("THRAWN_NO_HERDR") == "1":
        return False
    if not have("herdr"):
        return False
    proc = try_run(["herdr", "status"], timeout=5)
    return bool(proc and proc.returncode == 0)


def _first_match(pattern: str, text: str):
    m = re.search(pattern, text or "")
    return m.group(1) if m else None


class HerdrSpawner:
    """One ⚔ tab per run in the workspace thrawn was launched from; every
    agent of the run — tasks and integrators — stacks as a split pane
    inside it, so the whole run is visible on one screen."""

    def __init__(self, repo=None, state=None):
        self.repo = repo
        self.state = state if state is not None else {}
        self._fresh = False  # just created the tab; first agent takes root pane

    def _run_tab(self):
        """Find (or create) this run's tab; returns its id, or None."""
        tab = self.state.get("herdr_tab")
        if tab:
            proc = try_run(["herdr", "tab", "get", tab], timeout=5)
            if proc and proc.returncode == 0:
                return tab
            self.state["herdr_tab"] = None  # tab was closed — recreate
        run_id = self.state.get("run_id")
        if not run_id:
            return None
        proc = try_run(["herdr", "pane", "current"], timeout=5)
        workspace = _first_match(
            r'"workspace_id"\s*:\s*"([^"]+)"', (proc.stdout if proc else "") or ""
        )
        if not workspace:
            return None
        proc = try_run(
            ["herdr", "tab", "create", "--workspace", workspace,
             "--label", f"⚔ {run_id}", "--no-focus"],
            timeout=10,
        )
        tab = _first_match(
            r'"tab_id"\s*:\s*"([^"]+)"', (proc.stdout if proc else "") or ""
        )
        if tab:
            self._fresh = True
            self.state["herdr_tab"] = tab
            if self.repo is not None:
                save_state(self.repo, self.state)
            info(f"herdr tab {BOLD}⚔ {run_id}{RESET} — agents stack there as panes")
        return tab

    def spawn(self, name, label, cwd, cmdline):
        tab = self._run_tab()
        argv = ["herdr", "agent", "start", name, "--cwd", str(cwd), "--no-focus"]
        if tab:
            argv += ["--tab", tab]
            if not self._fresh:
                # the fresh tab's root pane takes the first agent;
                # everyone after that stacks below it
                argv += ["--split", "down"]
            self._fresh = False
        argv += ["--", "bash", "-lc", cmdline]
        proc = try_run(argv, timeout=15)
        out = ((proc.stdout or "") + (proc.stderr or "")) if proc else ""
        pane = _first_match(r'"(?:pane_id|terminal_id)"\s*:\s*"([^"]+)"', out)
        if proc is None or proc.returncode != 0:
            info(f"{YELLOW}herdr refused to open a pane for {label} — running "
                 f"headless; output only in the run logs{RESET}")
            return LocalSpawner().spawn(name, label, cwd, cmdline)
        if pane:
            try_run(["herdr", "pane", "rename", pane, label], timeout=5)
        return {"via": "herdr", "pane": pane, "tab": tab}

    def close(self, handle):
        if handle.get("via") == "herdr" and handle.get("pane"):
            try_run(["herdr", "pane", "close", handle["pane"]], timeout=5)
        elif handle.get("via") == "local":
            LocalSpawner().close(handle)


class LocalSpawner:
    """Fallback: detached background process; output is in the task log."""

    def spawn(self, name, label, cwd, cmdline):
        proc = subprocess.Popen(
            ["bash", "-lc", cmdline],
            cwd=cwd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return {"via": "local", "pid": proc.pid}

    def close(self, handle):
        pid = handle.get("pid")
        if pid:
            try:
                os.killpg(os.getpgid(pid), 15)
            except (OSError, ProcessLookupError):
                pass


def make_spawner(repo=None, state=None):
    if not herdr_available():
        return LocalSpawner()
    return HerdrSpawner(repo, state)


def notify(title: str, sound: str = "done") -> None:
    if herdr_available():
        try_run(["herdr", "notification", "show", title, "--sound", sound], timeout=5)


def wrapped_cmdline(argv, log: Path, exit_file: Path) -> str:
    cmd = " ".join(shlex.quote(a) for a in argv)
    me = shlex.quote(str(Path(__file__).resolve()))
    ef = shlex.quote(str(exit_file))
    return (
        "set -o pipefail; "
        f"{cmd} 2>&1 | tee {shlex.quote(str(log))} | {me} _fmt; ec=$?; "
        # write-then-rename so pollers never observe a half-written file
        f"echo $ec > {ef}.tmp && mv {ef}.tmp {ef}; "
        "echo; echo \"[thrawn] task finished with exit $ec\"; exit $ec"
    )


# ---------------------------------------------------------------------------
# Dispatch orchestration
# ---------------------------------------------------------------------------

def task_paths(repo: Path, run_id: str, task_id: str):
    rdir = run_dir(repo, run_id)
    return rdir / f"task-{task_id}.log", rdir / f"task-{task_id}.exit"


def setup_worktree(repo: Path, cfg: dict, run_id: str, worktree: Path, tag: str) -> None:
    """Optional per-repo setup after `git worktree add` (e.g. bundle install)."""
    cmd = cfg.get("worktree", {}).get("setup", "")
    if not cmd:
        return
    log = run_dir(repo, run_id) / f"setup-{tag}.log"
    ok = stream_cmd(["bash", "-lc", cmd], worktree, log, label=f"setup {tag}: {cmd}")
    if ok:
        info(f"worktree {tag} ready ({cmd})")
    else:
        info(f"{YELLOW}worktree setup failed for {tag} (see {log}) — "
             f"continuing, checks may catch it{RESET}")


def spawn_task(repo, cfg, state, plan, task, spawner):
    run_id = state["run_id"]
    tid = task["id"]
    branch = f"thrawn/{run_id}/{tid}"
    worktree = worktree_base(repo) / run_id / tid
    worktree.parent.mkdir(parents=True, exist_ok=True)
    run(
        ["git", "worktree", "add", "-b", branch, str(worktree), state["base_commit"]],
        cwd=repo,
    )
    setup_worktree(repo, cfg, run_id, worktree, tid)

    prompt = render(
        load_prompt("executor.md"),
        run_id=run_id,
        task_id=tid,
        task_title=task["title"],
        task_prompt=task["prompt"],
        summary=plan.get("summary", ""),
        branch=branch,
        siblings="\n".join(
            f"- {t['id']}: {t['title']}" for t in plan["tasks"] if t["id"] != tid
        )
        or "(none)",
        recon=load_recon(repo, cfg),
    )
    argv = runner_argv(cfg, task["runner"], prompt)
    if argv is None:
        die(f"runner `{task['runner']}` not defined in runners.toml")

    log, exit_file = task_paths(repo, run_id, tid)
    exit_file.unlink(missing_ok=True)
    handle = spawner.spawn(
        name=f"thrawn-{run_id}-{tid}",
        label=f"⚔ {tid} {task['title'][:24]}",
        cwd=worktree,
        cmdline=wrapped_cmdline(argv, log, exit_file),
    )
    state["tasks"][tid] = {
        "status": "running",
        "runner": task["runner"],
        "branch": branch,
        "worktree": str(worktree),
        "handle": handle,
        "started": now_iso(),
    }
    save_state(repo, state)


def poll_tasks(repo: Path, state: dict) -> None:
    for tid, ts in state["tasks"].items():
        if ts["status"] != "running":
            continue
        _, exit_file = task_paths(repo, state["run_id"], tid)
        if exit_file.exists():
            raw = exit_file.read_text().strip()
            if not raw:
                continue  # still being written — pick it up next poll
            try:
                code = int(raw)
            except ValueError:
                code = 1
            if code == 0:
                # exit 0 is not enough — the work must actually be ON the branch
                proc = try_run(
                    ["git", "rev-list", "--count",
                     f"{state['base_commit']}..{ts['branch']}"],
                    cwd=repo,
                )
                if proc and proc.returncode == 0 and proc.stdout.strip() == "0":
                    code = 1
                    ts["note"] = ("runner exited 0 but committed nothing — "
                                  f"check for unstaged work in {ts['worktree']}")
            ts["status"] = "done" if code == 0 else "failed"
            ts["exit"] = code
            ts["finished"] = now_iso()


def deps_done(plan: dict, state: dict, task: dict) -> bool:
    return all(
        state["tasks"].get(d, {}).get("status") == "done" for d in task["deps"]
    )


def render_plan(repo: Path, run_id: str, plan: dict, full: bool = False) -> None:
    """Readable plan summary; full=True prints every prompt verbatim."""
    print()
    print(f"{BOLD}⚔ plan {run_id}{RESET}  {plan.get('summary', '')}")
    print(f"  {DIM}branch:{RESET} {plan.get('branch', '')}")
    print()
    for task in plan["tasks"]:
        deps = (f"  {DIM}(after {', '.join(task['deps'])}){RESET}"
                if task.get("deps") else "")
        print(f"  {BOLD}{task['id']:<3}{RESET} {task['title'][:56]:<56} "
              f"{YELLOW}{task.get('runner', '?'):<6}{RESET} "
              f"{DIM}{task.get('complexity', '?')}{RESET}{deps}")
        if full:
            print()
            for ln in task.get("prompt", "").splitlines():
                print(f"      {ln}")
            print()
            if task.get("checks"):
                print(f"      {DIM}checks: {' · '.join(task['checks'])}{RESET}")
            print(f"  {DIM}{'─' * 70}{RESET}")
        else:
            first = next(
                (ln.strip() for ln in task.get("prompt", "").splitlines()
                 if ln.strip()),
                "",
            )
            if first:
                print(f"      {DIM}{first[:90]}{RESET}")
            if task.get("checks"):
                print(f"      {DIM}checks: {' · '.join(task['checks'])}{RESET}")
    print()
    if plan.get("checks"):
        print(f"  {DIM}integration checks:{RESET} {' · '.join(plan['checks'])}")
    pr = plan.get("pr", {})
    if pr.get("title"):
        print(f"  {DIM}PR:{RESET} {pr['title']}")
        if full and pr.get("body"):
            for ln in pr["body"].splitlines():
                print(f"      {DIM}{ln}{RESET}")
    print()
    print(f"  {DIM}full plan:{RESET} .thrawn/runs/{run_id}/plan.json")
    print(f"  {DIM}execute:{RESET}   thrawn watch {run_id}")


def render_board(repo: Path, state: dict, plan: dict, clear: bool = False) -> None:
    if clear:
        print("\x1b[2J\x1b[H", end="")
    else:
        print()
    print(f"{BOLD}⚔ thrawn{RESET} — {state['run_id']}  {DIM}{plan.get('summary','')[:60]}{RESET}")
    print(f"{DIM}phase: {state['phase']}   base: {state['base_branch']} @ {state['base_commit'][:8]}{RESET}")
    print()
    for task in plan["tasks"]:
        tid = task["id"]
        ts = state["tasks"].get(tid, {"status": "pending"})
        icon = STATUS_ICON.get(ts["status"], "?")
        deps = f" {DIM}(after {','.join(task['deps'])}){RESET}" if task["deps"] else ""
        print(
            f"  {icon} {tid:<4} {task['title'][:44]:<44} "
            f"{DIM}{task.get('runner','?'):<7}{RESET} {ts['status']}{deps}"
        )
        if ts.get("status") == "running":
            log, _ = task_paths(repo, state["run_id"], tid)
            act = describe_activity(log, 56)
            print(f"       {YELLOW}{since(ts.get('started', ''))}{RESET} "
                  f"{DIM}{act or 'no output yet'}{RESET}")
        if ts.get("note"):
            print(f"       {RED}{ts['note']}{RESET}")
    integ = state.get("integration", {})
    if integ:
        print()
        line = (f"  {DIM}integration:{RESET} {integ.get('status', 'pending')}"
                + (f"  attempt {integ['attempt']}" if integ.get("attempt") else ""))
        if state["phase"] == "integrating" and integ.get("stage_started"):
            line += f"  {YELLOW}{since(integ['stage_started'])}{RESET}"
        print(line)
        if state["phase"] == "integrating" and integ.get("activity_log"):
            act = describe_activity(Path(integ["activity_log"]), 60)
            print(f"    {DIM}↳ {act or 'working — no output yet'}{RESET}")
    print()
    if state["phase"] == "green":
        print(f"  {GREEN}{BOLD}ALL GREEN{RESET}  ship code: {BOLD}{state['ship_code']}{RESET}")
        print(f"  {DIM}→ thrawn ship {state['run_id']} --code {state['ship_code']}{RESET}")
    elif state["phase"] == "failed":
        print(f"  {RED}{BOLD}FAILED{RESET} — see logs in .thrawn/runs/{state['run_id']}/")
        print(f"  {DIM}fix things, then: thrawn integrate {state['run_id']}{RESET}")
    elif state["phase"] == "shipped":
        print(f"  {GREEN}{BOLD}SHIPPED{RESET}  {state.get('pr_url', '')}")
    elif state["phase"] in ("planned", "aborted"):
        print(f"  {DIM}phase: {state['phase']}{RESET}")
    else:
        print(f"  {DIM}watching … ctrl-c is safe; resume with `thrawn watch {state['run_id']}`{RESET}")


def watch(repo: Path, cfg: dict, state: dict) -> None:
    plan = json.loads((run_dir(repo, state["run_id"]) / "plan.json").read_text())
    spawner = make_spawner(repo, state)
    poll = cfg["thrawn"]["poll_seconds"]

    while True:
        poll_tasks(repo, state)
        for task in plan["tasks"]:
            ts = state["tasks"].get(task["id"])
            if ts is None and deps_done(plan, state, task):
                spawn_task(repo, cfg, state, plan, task, spawner)
        save_state(repo, state)
        render_board(repo, state, plan, clear=True)

        statuses = [
            state["tasks"].get(t["id"], {}).get("status", "pending")
            for t in plan["tasks"]
        ]
        if "failed" in statuses:
            failed = [
                t["id"] for t in plan["tasks"]
                if state["tasks"].get(t["id"], {}).get("status") == "failed"
            ]
            state["phase"] = "failed"
            save_state(repo, state)
            render_board(repo, state, plan)
            notify(f"thrawn {state['run_id']}: task {','.join(failed)} failed", "request")
            die(f"task(s) failed: {', '.join(failed)} — logs in "
                f".thrawn/runs/{state['run_id']}/\n"
                f"  `thrawn retry {state['run_id']}` reruns them "
                f"(--runner X to reroute); `thrawn adopt {state['run_id']} <task>` "
                f"takes work an agent left uncommitted")
        if all(s == "done" for s in statuses):
            break
        time.sleep(poll)

    integrate(repo, cfg, state)


# ---------------------------------------------------------------------------
# Integration — merge, fix, verify
# ---------------------------------------------------------------------------

def detect_checks(repo: Path, cfg: dict, plan: dict):
    if plan.get("checks"):
        return plan["checks"]
    if cfg["checks"]["commands"]:
        return cfg["checks"]["commands"]
    makefile = repo / "Makefile"
    if makefile.exists():
        targets = set(re.findall(r"^([A-Za-z0-9_.-]+):", makefile.read_text(), re.M))
        if "check" in targets:
            return ["make check"]
        cmds = [f"make {t}" for t in ("lint", "test") if t in targets]
        if cmds:
            return cmds
    return []


def run_integrator_agent(repo, cfg, state, worktree, mode, detail) -> bool:
    """Run the integrator in a visible pane, wait for it. True on exit 0."""
    run_id = state["run_id"]
    attempt = state["integration"]["attempt"]
    prompt = render(
        load_prompt("integrator.md"),
        run_id=run_id,
        mode=mode,
        detail=detail,
        branch=state["integration"]["branch"],
    )
    argv = runner_argv(cfg, cfg["thrawn"]["integrator"], prompt)
    if argv is None:
        die(f"integrator runner `{cfg['thrawn']['integrator']}` not defined")
    log = run_dir(repo, run_id) / f"integrator-{attempt}.log"
    exit_file = run_dir(repo, run_id) / f"integrator-{attempt}.exit"
    exit_file.unlink(missing_ok=True)
    state["integration"]["activity_log"] = str(log)
    state["integration"]["stage_started"] = now_iso()
    save_state(repo, state)
    spawner = make_spawner(repo, state)
    spawner.spawn(
        name=f"thrawn-{run_id}-integrator-{attempt}",
        label=f"⚔ integrator #{attempt}",
        cwd=worktree,
        cmdline=wrapped_cmdline(argv, log, exit_file),
    )
    start = time.monotonic()
    last_note = 0.0
    while not exit_file.exists():
        elapsed = time.monotonic() - start
        act = describe_activity(log, 50) or "working — no output yet"
        if sys.stdout.isatty():
            live(f"{YELLOW}◐{RESET} integrator #{attempt} [{mode}] "
                 f"{YELLOW}{fmt_dur(elapsed)}{RESET} {DIM}{act}{RESET}")
        elif elapsed - last_note >= 30:
            info(f"integrator #{attempt} [{mode}] {fmt_dur(elapsed)} — {act}")
            last_note = elapsed
        time.sleep(2)
    live_done()
    ok = exit_file.read_text().strip() == "0"
    verdict = f"{GREEN}ok{RESET}" if ok else f"{RED}failed{RESET}"
    info(f"integrator #{attempt} finished ({verdict}) "
         f"after {fmt_dur(time.monotonic() - start)}")
    return ok


def baseline_check(repo: Path, cfg: dict, state: dict, cmd: str):
    """Run a failed check against the base commit to assign blame.

    True  = passes on base -> the merged changes broke it.
    False = fails on base too -> pre-existing/environmental, not the feature.
    None  = could not determine."""
    run_id = state["run_id"]
    worktree = worktree_base(repo) / run_id / "_baseline"
    if not worktree.exists():
        proc = try_run(
            ["git", "worktree", "add", "--detach", str(worktree),
             state["base_commit"]],
            cwd=repo,
        )
        if proc is None or proc.returncode != 0:
            return None
        state["integration"]["baseline_worktree"] = str(worktree)
        save_state(repo, state)
        setup_worktree(repo, cfg, run_id, worktree, "baseline")
    log = run_dir(repo, run_id) / "baseline-check.log"
    info("triage: running the failed check against the base commit …")
    return stream_cmd(["bash", "-lc", cmd], worktree, log, label=f"baseline: {cmd}")


def integrate(repo: Path, cfg: dict, state: dict) -> None:
    run_id = state["run_id"]
    plan = json.loads((run_dir(repo, run_id) / "plan.json").read_text())
    state["phase"] = "integrating"
    integ = state.setdefault(
        "integration", {"status": "merging", "attempt": 0, "branch": plan["branch"]}
    )
    integ["status"] = "merging"
    integ["stage_started"] = now_iso()
    save_state(repo, state)

    worktree = worktree_base(repo) / run_id / "_integration"
    if not worktree.exists():
        proc = try_run(
            ["git", "worktree", "add", "-b", plan["branch"], str(worktree),
             state["base_commit"]],
            cwd=repo,
        )
        if proc is None or proc.returncode != 0:
            # branch may exist from a previous attempt
            run(["git", "worktree", "add", str(worktree), plan["branch"]], cwd=repo)
        setup_worktree(repo, cfg, run_id, worktree, "integration")
    integ["worktree"] = str(worktree)

    merged = set(integ.get("merged", []))
    for task in plan["tasks"]:
        tid = task["id"]
        if tid in merged:
            continue
        branch = state["tasks"][tid]["branch"]
        proc = try_run(["git", "merge", "--no-ff", "--no-edit", branch], cwd=worktree)
        if proc is None or proc.returncode != 0:
            integ["attempt"] += 1
            save_state(repo, state)
            status = try_run(["git", "status", "--porcelain"], cwd=worktree)
            detail = (
                f"Merging branch `{branch}` (task {tid}: {task['title']}) hit "
                f"conflicts.\n\ngit status:\n{status.stdout if status else '?'}"
            )
            info(f"{RED}merge conflict on {tid}{RESET} (worktree: {worktree})")
            if not (cfg["thrawn"]["auto_fix"] or confirm(
                    f"dispatch an integrator agent to resolve the conflict on {tid}?")):
                integ["status"] = "conflict-unresolved"
                state["phase"] = "failed"
                save_state(repo, state)
                die(f"conflict on {tid} left untouched — resolve it manually in "
                    f"{worktree}, or rerun `thrawn integrate {run_id}` and consent "
                    f"to the agent (auto_fix = true skips the question)")
            ok = run_integrator_agent(repo, cfg, state, worktree, "conflict", detail)
            unmerged = try_run(["git", "ls-files", "-u"], cwd=worktree)
            if not ok or (unmerged and unmerged.stdout.strip()):
                integ["status"] = "conflict-unresolved"
                state["phase"] = "failed"
                save_state(repo, state)
                die(f"integrator could not resolve conflicts for {tid} "
                    f"(worktree: {worktree})")
        merged.add(tid)
        integ["merged"] = sorted(merged)
        save_state(repo, state)

    # checks
    checks = detect_checks(repo, cfg, plan)
    if not checks and not cfg["thrawn"]["allow_no_checks"]:
        integ["status"] = "no-checks"
        state["phase"] = "failed"
        save_state(repo, state)
        die("no checks configured (plan, [checks] in .thrawn.toml, or Makefile) "
            "— refusing to declare a run green without verification. Add check "
            "commands, or set allow_no_checks = true to accept that risk.")
    integ["checks"] = checks
    max_attempts = cfg["thrawn"]["integrator_attempts"]
    while True:
        integ["status"] = "checking"
        integ["stage_started"] = now_iso()
        save_state(repo, state)
        failed_output = None
        for i, cmd in enumerate(checks):
            check_log = run_dir(repo, run_id) / f"check-{integ['attempt']}-{i}.log"
            integ["activity_log"] = str(check_log)
            save_state(repo, state)
            info(f"running check: {BOLD}{cmd}{RESET}")
            check_start = time.monotonic()
            ok = stream_cmd(["bash", "-lc", cmd], worktree, check_log,
                            label=f"check: {cmd}", echo=True)
            took = fmt_dur(time.monotonic() - check_start)
            if ok:
                info(f"{GREEN}✓ {cmd}{RESET} ({took})")
            else:
                info(f"{RED}✗ {cmd}{RESET} ({took}) — full output above "
                     f"and in {check_log}")
            if not ok:
                out = check_log.read_text() if check_log.exists() else ""
                failed_output = f"$ {cmd}\n{out.strip()[-4000:]}"
                base_ok = baseline_check(repo, cfg, state, cmd)
                if base_ok is False:
                    info(f"{YELLOW}triage: check fails on the base commit too — "
                         f"pre-existing/environmental, not the merged changes{RESET}")
                    failed_output += (
                        "\n\nTRIAGE: this check FAILS ON THE BASE COMMIT TOO. "
                        "The failure is pre-existing or environmental — it was NOT "
                        "caused by the merged changes. Fix the environment or the "
                        "pre-existing issue; do not rework the feature code. If only "
                        "a human can fix it (permissions, credentials, installs), "
                        "state exactly what they must run and exit non-zero."
                    )
                elif base_ok is True:
                    failed_output += (
                        "\n\nTRIAGE: this check passes on the base commit — the "
                        "failure was introduced by the merged changes."
                    )
                else:
                    info(f"{YELLOW}triage inconclusive — could not run the check "
                         f"against the base commit{RESET}")
                    failed_output += (
                        "\n\nTRIAGE: inconclusive — the check could not be run "
                        "against the base commit. Establish whether the failure "
                        "is pre-existing before changing feature code."
                    )
                break
        if failed_output is None:
            break
        integ["attempt"] += 1
        if integ["attempt"] > max_attempts:
            integ["status"] = "checks-failing"
            state["phase"] = "failed"
            save_state(repo, state)
            notify(f"thrawn {run_id}: checks failing", "request")
            die(f"checks still failing after {max_attempts} fix attempts "
                f"(worktree: {worktree})")
        if not (cfg["thrawn"]["auto_fix"] or confirm(
                f"dispatch an integrator agent to fix this (attempt {integ['attempt']})?")):
            integ["status"] = "checks-failing"
            state["phase"] = "failed"
            save_state(repo, state)
            die(f"checks failing, no agent dispatched — full output above and in "
                f".thrawn/runs/{run_id}/. Fix manually in {worktree}, or rerun "
                f"`thrawn integrate {run_id}` and consent to the agent "
                f"(auto_fix = true skips the question)")
        integ["status"] = f"fixing (attempt {integ['attempt']})"
        save_state(repo, state)
        info(f"dispatching integrator (attempt {integ['attempt']})")
        run_integrator_agent(
            repo, cfg, state, worktree, "checks",
            f"These checks failed:\n\n{failed_output}",
        )

    integ["status"] = "green"
    state["phase"] = "green"
    state["ship_code"] = f"{secrets.randbelow(10**6):06d}"
    save_state(repo, state)
    notify(f"thrawn {run_id}: ALL GREEN — thrawn ship {run_id} "
           f"--code {state['ship_code']}", "done")
    render_board(repo, state, plan)


# ---------------------------------------------------------------------------
# Ship — the code gate, then push + PR/MR
# ---------------------------------------------------------------------------

def ship(repo: Path, cfg: dict, run_id: str, code) -> None:
    state = load_state(repo, run_id)
    if state["phase"] == "shipped":
        die(f"run {run_id} already shipped: {state.get('pr_url', '')}")
    if state["phase"] != "green":
        die(f"run {run_id} is not green (phase: {state['phase']}) — nothing ships "
            "until the board is green")
    if not code:
        die("ship code required: --code NNNNNN (it is on the status board)")
    if code != state["ship_code"]:
        die("wrong ship code — read it off `thrawn status`")

    plan = json.loads((run_dir(repo, run_id) / "plan.json").read_text())
    worktree = Path(state["integration"]["worktree"])
    branch = state["integration"]["branch"]
    host, _ = detect_host(repo)

    proc = try_run(["git", "push", "-u", "origin", branch], cwd=worktree)
    if proc is None or proc.returncode != 0:
        die(f"push failed:\n{(proc.stderr if proc else '').strip()[-1500:]}")
    info(f"pushed {branch}")

    title, body = plan["pr"]["title"], plan["pr"]["body"]
    if state["target"]["kind"] == "github":
        body += f"\n\nCloses #{state['target']['ref']}"
    body += "\n\n⚔ orchestrated by thrawn"
    url = ""
    if host == "github" and have("gh"):
        proc = try_run(
            ["gh", "pr", "create", "--title", title, "--body", body,
             "--head", branch, "--base", state["base_branch"]],
            cwd=worktree,
        )
        if proc and proc.returncode == 0:
            url = proc.stdout.strip().splitlines()[-1]
    elif host == "gitlab" and have("glab"):
        proc = try_run(
            ["glab", "mr", "create", "--title", title, "--description", body,
             "--source-branch", branch, "--target-branch", state["base_branch"],
             "--yes"],
            cwd=worktree,
        )
        if proc and proc.returncode == 0:
            match = re.search(r"https?://\S+", proc.stdout)
            url = match.group(0) if match else ""
    if not url:
        info(f"{YELLOW}branch pushed but PR/MR creation failed or unsupported — "
             f"create it manually{RESET}")
    else:
        info(f"{GREEN}opened: {url}{RESET}")
        if state["target"]["kind"] == "github" and have("gh"):
            try_run(["gh", "issue", "comment", state["target"]["ref"],
                     "--body", f"⚔ thrawn shipped this: {url}"], cwd=repo)

    # the worktrees' purpose ends at ship — release the branch so a normal
    # `git checkout <branch>` works in the main checkout again
    for ts in state["tasks"].values():
        wt = ts.get("worktree")
        if wt and Path(wt).exists():
            try_run(["git", "worktree", "remove", "--force", wt], cwd=repo)
        if ts.get("branch"):
            try_run(["git", "branch", "-D", ts["branch"]], cwd=repo)
    if worktree.exists():
        proc = try_run(["git", "worktree", "remove", str(worktree)], cwd=repo)
        if proc and proc.returncode == 0:
            info(f"released {BOLD}{branch}{RESET} — "
                 f"`git checkout {branch}` now works in your checkout")
        else:
            info(f"{YELLOW}kept worktree (uncommitted changes?): {worktree}{RESET}")
    state["phase"] = "shipped"
    state["pr_url"] = url
    state["shipped"] = now_iso()
    save_state(repo, state)
    notify(f"thrawn {run_id}: shipped", "done")


# ---------------------------------------------------------------------------
# Other commands
# ---------------------------------------------------------------------------

def cmd_status(repo: Path, run_id) -> None:
    state = load_state(repo, run_id) if run_id else latest_run(repo)
    plan_path = run_dir(repo, state["run_id"]) / "plan.json"
    if plan_path.exists():
        poll_tasks(repo, state)
        save_state(repo, state)
        render_board(repo, state, json.loads(plan_path.read_text()))
    else:
        print(json.dumps(state, indent=2))


def cmd_runs(repo: Path) -> None:
    runs = list_runs(repo)
    if not runs:
        info("no runs yet")
        return
    for state in runs:
        colour = {"green": GREEN, "shipped": GREEN, "failed": RED}.get(
            state["phase"], YELLOW
        )
        print(f"  {state['run_id']:<20} {colour}{state['phase']:<12}{RESET} "
              f"{DIM}{state.get('created', '')}{RESET}  "
              f"{state.get('target', {}).get('title', '')[:48]}")


def cmd_abort(repo: Path, run_id) -> None:
    state = load_state(repo, run_id) if run_id else latest_run(repo)
    spawner = make_spawner()
    for ts in state["tasks"].values():
        if ts.get("handle"):
            spawner.close(ts["handle"])
        wt = ts.get("worktree")
        if wt and Path(wt).exists():
            try_run(["git", "worktree", "remove", "--force", wt], cwd=repo)
        if ts.get("branch"):
            try_run(["git", "branch", "-D", ts["branch"]], cwd=repo)
    integ = state.get("integration", {})
    for key in ("worktree", "baseline_worktree"):
        if integ.get(key) and Path(integ[key]).exists():
            try_run(["git", "worktree", "remove", "--force", integ[key]], cwd=repo)
    if state.get("herdr_tab"):
        try_run(["herdr", "tab", "close", state["herdr_tab"]], timeout=5)
    state["phase"] = "aborted"
    save_state(repo, state)
    info(f"aborted {state['run_id']} — worktrees removed, task branches deleted")


def _recovery_targets(state: dict, task_ids, verb: str):
    """Validate task ids for retry/adopt; default to everything failed."""
    failed = [t for t, ts in state["tasks"].items() if ts.get("status") == "failed"]
    if not task_ids:
        return failed
    unknown = [t for t in task_ids if t not in state["tasks"]]
    if unknown:
        die(f"no such task(s) in {state['run_id']}: {', '.join(unknown)}")
    healthy = [t for t in task_ids if t not in failed]
    if healthy:
        die(f"can only {verb} failed tasks — not "
            + ", ".join(f"{t} ({state['tasks'][t]['status']})" for t in healthy))
    return list(task_ids)


def cmd_retry(repo: Path, cfg: dict, run_ref, task_ids,
              runner=None, force=False) -> None:
    """Reset failed tasks so watch re-spawns them; falls through to
    integration retry when nothing failed at the task level."""
    state = load_state(repo, run_ref) if run_ref else latest_run(repo)
    rid = state["run_id"]
    if state["phase"] in ("shipped", "aborted"):
        die(f"run {rid} is {state['phase']}")
    if runner and runner not in cfg["runners"]:
        die(f"runner `{runner}` not defined in runners.toml")

    targets = _recovery_targets(state, task_ids, "retry")
    if not targets:
        if state["phase"] == "green":
            die(f"run {rid} is green — nothing to retry "
                f"(`thrawn status {rid}` for the ship code)")
        info(f"no failed tasks in {rid} — retrying integration")
        integrate(repo, cfg, state)
        return

    # protect possibly-salvageable work: a runner that exited 0 without
    # committing usually left the whole change unstaged in its worktree
    if not force:
        for tid in targets:
            wt = state["tasks"][tid].get("worktree")
            if wt and Path(wt).exists():
                porc = try_run(["git", "status", "--porcelain"], cwd=wt)
                if porc and porc.stdout.strip():
                    die(f"{tid}'s worktree has uncommitted work — look first:\n"
                        f"    {wt}\n"
                        f"  `thrawn adopt {rid} {tid}` to take it, "
                        f"or retry with --force to discard it")

    plan_path = run_dir(repo, rid) / "plan.json"
    plan = json.loads(plan_path.read_text())
    spawner = make_spawner()
    for tid in targets:
        ts = state["tasks"].pop(tid)
        if ts.get("handle"):
            spawner.close(ts["handle"])
        wt = ts.get("worktree")
        if wt and Path(wt).exists():
            try_run(["git", "worktree", "remove", "--force", wt], cwd=repo)
        if ts.get("branch"):
            try_run(["git", "branch", "-D", ts["branch"]], cwd=repo)
        if runner:
            for task in plan["tasks"]:
                if task["id"] == tid:
                    task["runner"] = runner
    if runner:
        plan_path.write_text(json.dumps(plan, indent=2))
    info(f"retrying {', '.join(targets)}"
         + (f" on {BOLD}{runner}{RESET}" if runner else ""))
    state["phase"] = "working"
    save_state(repo, state)
    watch(repo, cfg, state)


def cmd_adopt(repo: Path, cfg: dict, run_ref, task_ids) -> None:
    """Accept a failed task's work as done: commit anything unstaged in its
    worktree, verify the branch actually has commits, mark done, resume."""
    state = load_state(repo, run_ref) if run_ref else latest_run(repo)
    rid = state["run_id"]
    if state["phase"] in ("shipped", "aborted"):
        die(f"run {rid} is {state['phase']}")

    targets = _recovery_targets(state, task_ids, "adopt")
    if not targets:
        die(f"nothing to adopt in {rid} — no failed tasks")

    for tid in targets:
        ts = state["tasks"][tid]
        wt = ts.get("worktree")
        if not wt or not Path(wt).exists():
            die(f"{tid} has no worktree to adopt from")
        porc = run(["git", "status", "--porcelain"], cwd=Path(wt)).stdout.strip()
        if porc:
            run(["git", "add", "-A"], cwd=Path(wt))
            run(["git", "commit", "-m", f"{tid}: adopt uncommitted agent work"],
                cwd=Path(wt))
            info(f"{tid}: committed the unstaged work it left behind")
        count = run(
            ["git", "rev-list", "--count", f"{state['base_commit']}..{ts['branch']}"],
            cwd=repo,
        ).stdout.strip()
        if count == "0":
            die(f"{tid}: nothing to adopt — no commits and no uncommitted "
                f"changes in {wt}")
        ts["status"] = "done"
        ts["exit"] = 0
        ts["finished"] = now_iso()
        ts.pop("note", None)
        info(f"{tid}: adopted — {count} commit(s) on {ts['branch']}")
    state["phase"] = "working"
    save_state(repo, state)
    watch(repo, cfg, state)


def find_open_run(repo: Path, intake: dict):
    """Most recent unfinished run for the same ticket/brief, if any."""
    matches = [
        s for s in list_runs(repo)
        if s.get("target", {}).get("kind") == intake["kind"]
        and str(s.get("target", {}).get("ref")) == str(intake["ref"])
        and s.get("phase") not in ("shipped", "aborted", "planning")
    ]
    return sorted(matches, key=lambda s: s.get("created", ""))[-1] if matches else None


def continue_run(repo: Path, cfg: dict, prev: dict) -> None:
    """Pick an existing run back up instead of re-planning the same target."""
    rid, phase = prev["run_id"], prev["phase"]
    if phase == "green":
        die(f"run {rid} for this target is already GREEN — "
            f"`thrawn status {rid}` shows the ship code "
            f"(or `--new` for a fresh run)")
    if phase == "failed":
        die(f"run {rid} for this target FAILED — `thrawn retry {rid}` to rerun "
            f"what failed, `thrawn abort {rid}` to scrap it, or `--new` to re-plan")
    if phase == "planned":
        plan = json.loads((run_dir(repo, rid) / "plan.json").read_text())
        info(f"run {BOLD}{rid}{RESET} already has a plan — executing it, "
             f"NOT re-planning {DIM}(`thrawn plan {rid} --again` to re-plan, "
             f"`--new` for a fresh run){RESET}")
        head = run(["git", "rev-parse", "HEAD"], cwd=repo).stdout.strip()
        if prev["base_commit"] != head:
            info(f"{YELLOW}note: plan was made at {prev['base_commit'][:8]}; "
                 f"tasks branch from there, not current HEAD{RESET}")
        render_plan(repo, rid, plan)
    else:  # working / integrating — orchestrator died or was ctrl-c'd
        info(f"run {BOLD}{rid}{RESET} is already {phase} — resuming watch")
    prev["phase"] = "working"
    save_state(repo, prev)
    watch(repo, cfg, prev)


def dispatch(repo: Path, cfg: dict, target, plan_only: bool,
             force_new: bool = False) -> None:
    ensure_git_exclude(repo)
    intake = resolve_target(repo, target)
    if not plan_only and not force_new:
        prev = find_open_run(repo, intake)
        if prev:
            continue_run(repo, cfg, prev)
            return
    if cfg["thrawn"]["auto_recon"] and not recon_paths(repo)[0].exists():
        info("no recon cache for this repo — surveying first (step 0)")
        cmd_recon(repo, cfg)
    dirty = try_run(["git", "status", "--porcelain"], cwd=repo)
    if dirty and dirty.stdout.strip():
        info(f"{YELLOW}note: uncommitted changes in this repo will NOT be visible "
             f"to task agents (they branch from HEAD){RESET}")
    run_id = make_run_id(repo, intake)
    info(f"run {BOLD}{run_id}{RESET}: {intake['title']}")

    base_branch = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=repo).stdout.strip()
    base_commit = run(["git", "rev-parse", "HEAD"], cwd=repo).stdout.strip()
    state = {
        "run_id": run_id,
        "created": now_iso(),
        "phase": "planning",
        "target": {"kind": intake["kind"], "ref": intake["ref"], "title": intake["title"]},
        "base_branch": base_branch,
        "base_commit": base_commit,
        "tasks": {},
    }
    save_state(repo, state)

    plan = run_planner(repo, cfg, intake, run_id)
    info(f"plan: {len(plan['tasks'])} task(s) → "
         + ", ".join(f"{t['id']}[{t['runner']}]" for t in plan["tasks"]))
    if plan_only:
        state["phase"] = "planned"
        save_state(repo, state)
        render_plan(repo, run_id, plan)
        return

    state["phase"] = "working"
    save_state(repo, state)
    watch(repo, cfg, state)


# ---------------------------------------------------------------------------
# Entrypoint
# ---------------------------------------------------------------------------

USAGE = f"""{BOLD}⚔ thrawn{RESET} — plan deeply, execute in parallel

  thrawn <issue#>              dispatch from a GitHub/GitLab issue
  thrawn <brief.md>            dispatch from a markdown brief
  thrawn                       dispatch from ./THRAWN.md
                               (an open run for the same target is resumed,
                                never re-planned — force fresh with --new)
  thrawn plan <target>         plan only (review before executing)
  thrawn plan <run>            re-show the saved plan of an existing run
  thrawn plan <run> --full     the whole plan: every prompt verbatim, PR body
  thrawn plan <run> --again    unhappy with it? re-run the planner fresh
  thrawn recon                 cache a codebase brief (faster/cheaper planning)
  thrawn watch [run]           resume/execute a run
  thrawn status [run]          show the board (and ship code when green)
  thrawn ship <run> --code N   push + open PR/MR (requires green + code)
  thrawn retry [run] [task…]   rerun failed tasks (default: all of them;
                               --runner X reroutes, --force discards
                               uncommitted worktree changes)
  thrawn adopt [run] [task…]   accept a failed task's work as done —
                               commits anything it left unstaged
  thrawn integrate [run]       retry the integration phase
  thrawn runs                  list runs in this repo
  thrawn abort [run]           kill agents, remove worktrees + branches
"""


def cmd_fmt() -> None:
    """Hidden: render claude stream-json from stdin as readable pane output.

    The raw JSONL still lands in the task log (tee runs before us) — this is
    purely so a herdr pane shows what the agent is doing, not JSON soup.
    Non-JSON lines (codex, plain runners) pass through untouched."""
    for line in sys.stdin:
        stripped = line.strip()
        if not stripped.startswith("{"):
            if stripped:
                print(stripped, flush=True)
            continue
        try:
            evt = json.loads(stripped)
        except json.JSONDecodeError:
            print(stripped, flush=True)
            continue
        etype = evt.get("type")
        if etype == "system" and evt.get("subtype") == "init":
            print(f"· session started ({evt.get('model', '?')})", flush=True)
        elif etype == "assistant":
            for block in (evt.get("message") or {}).get("content", []):
                if block.get("type") == "text" and block.get("text", "").strip():
                    print(block["text"].strip(), flush=True)
                elif block.get("type") == "tool_use":
                    arg = block.get("input") or {}
                    hint = (arg.get("description") or arg.get("command")
                            or arg.get("file_path") or arg.get("pattern") or "")
                    name = block.get("name", "tool")
                    print(f"▸ {name}: {hint[:120]}" if hint else f"▸ {name}",
                          flush=True)
        elif etype == "result":
            print(f"■ result: {evt.get('subtype', 'done')}", flush=True)


def main() -> None:
    args = sys.argv[1:]
    if args and args[0] == "_fmt":
        cmd_fmt()
        return
    if args and args[0] in ("-h", "--help", "help"):
        print(USAGE)
        return

    repo = repo_root()
    cfg = load_config(repo)
    force_new = "--new" in args
    args = [a for a in args if a != "--new"]
    sub = args[0] if args else None

    if sub == "recon":
        cmd_recon(repo, cfg)
    elif sub == "plan":
        flags = [a for a in args[1:] if a.startswith("--")]
        rest = [a for a in args[1:] if not a.startswith("--")]
        target = rest[0] if rest else None
        again = "--again" in flags
        full = "--full" in flags
        if target and run_dir(repo, target).exists():
            state = load_state(repo, target)
            if again:
                # unhappy with the plan -> re-run the planner on the original
                # target and overwrite plan.json (only before execution starts)
                if state["phase"] not in ("planning", "planned"):
                    die(f"run {target} is {state['phase']} — re-planning after "
                        f"execution has started would orphan running work")
                tgt = state["target"]
                intake = (fetch_issue(repo, tgt["ref"])
                          if tgt["kind"] in ("github", "gitlab")
                          else read_brief(Path(tgt["ref"])))
                info(f"re-planning {target} from {tgt['kind']} {tgt['ref']} …")
                plan = run_planner(repo, cfg, intake, target)
                render_plan(repo, target, plan, full=full)
            else:
                # existing run id -> show its saved plan, don't re-plan
                plan_path = run_dir(repo, target) / "plan.json"
                if not plan_path.exists():
                    die(f"run {target} has no plan.json")
                render_plan(repo, target,
                            json.loads(plan_path.read_text()), full=full)
        else:
            dispatch(repo, cfg, target, plan_only=True)
    elif sub == "watch":
        state = load_state(repo, args[1]) if len(args) > 1 else latest_run(repo)
        if state["phase"] in ("shipped", "aborted"):
            die(f"run {state['run_id']} is {state['phase']}")
        state["phase"] = "working"
        watch(repo, cfg, state)
    elif sub == "status":
        cmd_status(repo, args[1] if len(args) > 1 else None)
    elif sub == "runs":
        cmd_runs(repo)
    elif sub == "abort":
        cmd_abort(repo, args[1] if len(args) > 1 else None)
    elif sub == "integrate":
        state = load_state(repo, args[1]) if len(args) > 1 else latest_run(repo)
        integrate(repo, cfg, state)
    elif sub == "retry":
        parser = argparse.ArgumentParser(prog="thrawn retry")
        parser.add_argument("run_id", nargs="?")
        parser.add_argument("tasks", nargs="*")
        parser.add_argument("--runner")
        parser.add_argument("--force", action="store_true")
        ns = parser.parse_args(args[1:])
        cmd_retry(repo, cfg, ns.run_id, ns.tasks, ns.runner, ns.force)
    elif sub == "adopt":
        parser = argparse.ArgumentParser(prog="thrawn adopt")
        parser.add_argument("run_id", nargs="?")
        parser.add_argument("tasks", nargs="*")
        ns = parser.parse_args(args[1:])
        cmd_adopt(repo, cfg, ns.run_id, ns.tasks)
    elif sub == "ship":
        parser = argparse.ArgumentParser(prog="thrawn ship")
        parser.add_argument("run_id")
        parser.add_argument("--code", required=True)
        ns = parser.parse_args(args[1:])
        ship(repo, cfg, ns.run_id, ns.code)
    else:
        dispatch(repo, cfg, sub, plan_only=False, force_new=force_new)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
        info("interrupted — running agents keep going; resume with `thrawn watch`")
        sys.exit(130)
